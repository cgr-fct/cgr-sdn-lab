#!/bin/bash
# Start Open vSwitch inside the container (run automatically when the dev container starts).
if ovs-vsctl --timeout=2 show >/dev/null 2>&1; then
  echo "Open vSwitch is already running."
  exit 0
fi
/usr/share/openvswitch/scripts/ovs-ctl start --system-id=random >/tmp/ovs-start.log 2>&1
if ovs-vsctl --timeout=5 show >/dev/null 2>&1; then
  echo "Open vSwitch started ($(ovs-vswitchd --version | head -1))."
else
  echo "ERROR: Open vSwitch did not start. Log:" >&2
  cat /tmp/ovs-start.log >&2
  echo "Is the container running with --privileged? (see docs/troubleshooting.md)" >&2
  exit 1
fi
